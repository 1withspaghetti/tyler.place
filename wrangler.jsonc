{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tyler-place",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_flags": [],
	"compatibility_date": "2026-09-15",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": false,
	"routes": [
		{
			"pattern": "tyler.place",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"keep_vars": true,
}
